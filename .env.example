# EDXS live API gateway. Override this value per environment when required.
VITE_API_BASE_URL=http://demo.kcompute.com:8063
VITE_DEMO_ADMISSION_CLIENT_CODE=101
VITE_DEMO_ADMISSION_ENTITY_ID=1

# One Window Job Portal, where candidates apply. Leave blank to fall back to
# the site's own contact page.
VITE_JOB_PORTAL_URL=

# Where a new trial account signs in to the EDXS app. Leave blank to hide the
# "Go to Login" button on the trial confirmation screen.
VITE_APP_LOGIN_URL=
